// One form per run: choose the function for a language in the menu next to Run.
function buildEn() { build(0); }
function buildIt() { build(1); }
function buildDe() { build(2); }
function buildFr() { build(3); }
function buildNl() { build(4); }
function buildEs() { build(5); }

// Runs a step and writes in the log which one failed, without stopping the rest.
function step(name, fn) {
  try { return fn(); } catch (e) { Logger.log('FAILED at ' + name + ': ' + e); return null; }
}

function build(li) {
  var form = FormApp.create(DATA.title[li] + ' [' + DATA.langs[li] + ']');
  Logger.log(DATA.langs[li] + ' edit: ' + form.getEditUrl());
  step('description', function () { form.setDescription(DATA.intro[li]); });
  var first = null, n = 0;
  DATA.sections.forEach(function (s, si) {
    if (si > 0) step('section ' + s.t[li], function () { form.addPageBreakItem().setTitle(s.t[li]); });
    s.q.forEach(function (q) {
      n++;
      step('question ' + n, function () {
        var opts = q.opts.map(function (o) { return o[li]; });
        var item;
        if (q.type === 'open') { form.addParagraphTextItem().setTitle(q.text[li]); return; }
        if (q.type === 'list') { item = form.addListItem(); }
        else if (q.type.indexOf('multi') === 0) { item = form.addCheckboxItem(); }
        else { item = form.addMultipleChoiceItem(); }
        item.setTitle(q.text[li]).setChoiceValues(opts).setRequired(true);
        if (q.type === 'multi_other' || q.type === 'single_other') step('other option ' + n, function () { item.showOtherOption(true); });
        if (q.type === 'multi3') step('limit of three ' + n, function () {
          item.setValidation(FormApp.createCheckboxValidation().requireSelectAtMost(3).build());
        });
        if (q.type === 'single_end') first = { item: item, opts: opts };
      });
    });
  });
  // "No" to the first question ends the survey; the other answers continue.
  if (first) step('end on No', function () {
    first.item.setChoices(first.opts.map(function (o, i) {
      return first.item.createChoice(o, i === first.opts.length - 1 ? FormApp.PageNavigationType.SUBMIT : FormApp.PageNavigationType.CONTINUE);
    }));
  });
  Logger.log(DATA.langs[li] + ' share: ' + form.getPublishedUrl());
  Logger.log(DATA.langs[li] + ' done, ' + n + ' questions');
}
