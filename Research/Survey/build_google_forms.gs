function buildAll() {
  DATA.langs.forEach(function (lang, li) { build(li); });
}

function build(li) {
  var form = FormApp.create(DATA.title[li] + ' [' + DATA.langs[li] + ']');
  form.setDescription(DATA.intro[li]).setCollectEmail(false).setProgressBar(true);
  var first = null, breaks = [];
  DATA.sections.forEach(function (s, si) {
    if (si > 0) breaks.push(form.addPageBreakItem().setTitle(s.t[li]));
    s.q.forEach(function (q) {
      var opts = q.opts.map(function (o) { return o[li]; });
      var item;
      if (q.type === 'open') { form.addParagraphTextItem().setTitle(q.text[li]); return; }
      if (q.type === 'list') { item = form.addListItem().setChoiceValues(opts); }
      else if (q.type.indexOf('multi') === 0) {
        item = form.addCheckboxItem().setChoiceValues(opts);
        if (q.type === 'multi3') item.setValidation(FormApp.createCheckboxValidation().requireSelectAtMost(3).build());
        if (q.type === 'multi_other') item.showOtherOption(true);
      } else {
        item = form.addMultipleChoiceItem().setChoiceValues(opts);
        if (q.type === 'single_other') item.showOtherOption(true);
        if (q.type === 'single_end') first = { item: item, opts: opts };
      }
      item.setTitle(q.text[li]).setRequired(true);
    });
  });
  // "No" to the first question ends the survey; the other answers continue.
  first.item.setChoices(first.opts.map(function (o, i) {
    return first.item.createChoice(o, i === first.opts.length - 1 ? FormApp.PageNavigationType.SUBMIT : FormApp.PageNavigationType.CONTINUE);
  }));
  Logger.log(DATA.langs[li] + ' edit: ' + form.getEditUrl());
  Logger.log(DATA.langs[li] + ' share: ' + form.getPublishedUrl());
}
